flowchart LR
    CLIENT(["Client / Campaign System"])

    subgraph OFFLINE["Offline: Data & Training"]
        DATA[("Raw + Synthetic\nEvents")]
        FEATURES["Feature Engineering\n(RFM) & Labeling"]
        TRAINING["Model Training\n(local baseline / SageMaker)"]
        MODEL[("Model Artifacts\n(XGBoost + metadata)")]
        DATA --> FEATURES --> TRAINING --> MODEL
    end

    subgraph ONLINE["Online: Inference Service"]
        API["FastAPI Churn Service\n(/predict, /health)"]
    end

    subgraph PLATFORM["AWS Platform (EKS)"]
        ALB["ALB + WAF\n(ingress, rate limiting)"]
        K8S["Kubernetes Deployment\n(churn-service pod)"]
        OTEL["OTel Collector"]
    end

    subgraph AWSCORE["Supporting AWS Services"]
        S3[("S3 Data Lake\nraw / training / models")]
        SAGEMAKER["SageMaker Training Job"]
        ECR["ECR (container images)"]
        CW["CloudWatch\n(dashboard & logs)"]
        IAM["IAM / Pod Identity"]
    end

    CLIENT --> ALB --> K8S --> API
    API <--> S3
    MODEL --> S3
    TRAINING <--> SAGEMAKER
    SAGEMAKER <--> S3
    API --> ECR
    ECR --> K8S
    API --> OTEL --> CW
    IAM -.-> K8S
    IAM -.-> SAGEMAKER
    IAM -.-> ALB
